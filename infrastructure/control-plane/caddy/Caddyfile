# Lumine Control Plane — single public entrypoint :80/:443
# Landing page PUBLIK di /; semua app di belakang Authelia (kecuali /auth).
# Logout: /auth/logout?rd=<url> (tombol di Homepage header + portal Authelia).
#
# Routing Uptime Kuma: /dashboard sbg main entry (Kuma Vue SPA hardcodes
# path ini). /health & /monitoring → redirect ke /dashboard.
{
	admin off
}

https://166.88.227.177 {
	tls internal

	# Access log untuk debugging (lihat request yang jatuh ke upstream mana)
	log {
		output stdout
		format console
	}

	# ── Authelia portal (bebas auth; Authelia basepath /auth) ──
	handle /auth* {
		reverse_proxy 127.0.0.1:9091
	}

	# Logout redirect (tombol portal Authelia + Homepage header)
	handle /logout* {
		redir * /auth/logout?rd=https://166.88.227.177/ 302
	}

	# ── LANDING PAGE — PUBLIK (marketing; nginx container 127.0.0.1:8080) ──
	# /site* dipertahankan sebagai alias kompatibilitas (link lama tetap jalan).
	#
	# Homepage PWA manifest — HARUS SEBELUM handle_path /site*: /site.webmanifest
	# kena strip /site → ".webmanifest" (tanpa slash) → nginx landing balas 400.
	# Browser minta /site.webmanifest?v=4 (insiden 2026-08-11).
	handle /site.webmanifest {
		reverse_proxy 127.0.0.1:3000
	}

	handle_path /site* {
		reverse_proxy 127.0.0.1:8080
	}
	handle / {
		reverse_proxy 127.0.0.1:8080
	}

	# ── Landing: asset absolut (HTML pakai ./assets/* → resolve /assets/*,
	# dan /favicon.svg). Tanpa split ini jatuh ke route Kuma → landing tanpa
	# CSS/JS. Pecah via Referer dari halaman landing (/ atau /site/) —
	# pola sama dengan @hermes (insiden 2026-08-08). ──
	@landing {
		path /assets/* /favicon.svg
		header_regexp Referer ^https?://[^/]*/(site/)?$
	}
	handle @landing {
		reverse_proxy 127.0.0.1:8080
	}

	# ── Homepage: static assets & API (Next.js app di /portal) ──
	# HTML Homepage berisi absolute path (/_next/*, /api/services, dll).
	# Caddy hanya proxy /portal* → 127.0.0.1:3000, jadi path absolute ini
	# harus di-route eksplisit. Tanpa ini → JS gagal load → UI fallback default.

	# Next.js bundles (no auth untuk performa)
	handle /_next/* {
		reverse_proxy 127.0.0.1:3000
	}

	# Homepage API (di balik auth)
	handle /api/services* {
		forward_auth 127.0.0.1:9091 {
			uri /auth/api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy 127.0.0.1:3000
	}

	handle /api/docker/status* {
		forward_auth 127.0.0.1:9091 {
			uri /auth/api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy 127.0.0.1:3000
	}

	handle /api/docker/stats* {
		forward_auth 127.0.0.1:9091 {
			uri /auth/api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy 127.0.0.1:3000
	}

	handle /api/bookmarks* {
		forward_auth 127.0.0.1:9091 {
			uri /auth/api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy 127.0.0.1:3000
	}

	handle /api/widgets* {
		forward_auth 127.0.0.1:9091 {
			uri /auth/api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy 127.0.0.1:3000
	}

	handle /api/hash* {
		forward_auth 127.0.0.1:9091 {
			uri /auth/api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy 127.0.0.1:3000
	}

	handle /api/config/* {
		forward_auth 127.0.0.1:9091 {
			uri /auth/api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy 127.0.0.1:3000
	}

	# Homepage: version check (releases) + config validation (validate) —
	# client pakai path ABSOLUT /api/* (hardcoded di JS), tanpa route ini
	# jatuh ke catch-all 404 (insiden 2026-08-11).
	handle /api/releases* {
		forward_auth 127.0.0.1:9091 {
			uri /auth/api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy 127.0.0.1:3000
	}

	handle /api/validate* {
		forward_auth 127.0.0.1:9091 {
			uri /auth/api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy 127.0.0.1:3000
	}

	# Homepage static assets (favicons — no auth)
	handle /favicon-*.png {
		reverse_proxy 127.0.0.1:3000
	}

	handle /homepage.ico {
		reverse_proxy 127.0.0.1:3000
	}

	handle /apple-touch-icon.png {
		reverse_proxy 127.0.0.1:3000
	}

	handle /safari-pinned-tab.svg {
		reverse_proxy 127.0.0.1:3000
	}

	# ── Portal hub (Homepage) ──
	# route{} = raw routing: forward_auth SEBELUM strip /portal → rd=
	# Authelia tetap /portal/... (tanpa route{} adapter mengeksekusi strip
	# dulu → login mendarat di path salah, insiden 2026-08-08).
	handle /portal {
		redir * /portal/ 308
	}

	@portal_path path /portal*
	handle @portal_path {
		route {
			forward_auth 127.0.0.1:9091 {
				uri /auth/api/authz/forward-auth
				copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
			}
			uri strip_prefix /portal
			reverse_proxy 127.0.0.1:3000
		}
	}

	# ── Hermes dashboard (Host header timpa → 127.0.0.1:9119) ──
	# route{}: forward_auth SEBELUM strip /hermes → rd= Authelia tetap
	# /hermes/... (pola sama dengan /status, insiden 2026-08-08).
	#
	# WS Hermes: bypass forward_auth. Authelia menolak handshake WS upgrade
	# (403 text/plain) walau session valid → "Chat connection interrupted
	# (code 1006)" di browser. Keamanan tetap terjaga: backend hermes
	# memvalidasi token ?token= (tanpa token valid → 400).
	@hermes_ws {
		path /hermes/api/ws* /hermes/api/events* /hermes/api/pty*
		header_regexp Upgrade (?i)websocket
	}
	handle @hermes_ws {
		uri strip_prefix /hermes
		reverse_proxy 127.0.0.1:9119 {
			header_up X-Forwarded-Prefix /hermes
			header_up Host 127.0.0.1:9119
			header_up Origin http://127.0.0.1:9119
				transport http {
					versions 1.1
				}
		}
	}

	@hermes_path path /hermes*
	handle @hermes_path {
		route {
			forward_auth 127.0.0.1:9091 {
				uri /auth/api/authz/forward-auth
				copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
			}
			uri strip_prefix /hermes
			reverse_proxy 127.0.0.1:9119 {
				header_up X-Forwarded-Prefix /hermes
				header_up Host 127.0.0.1:9119
				header_up Origin http://127.0.0.1:9119
				transport http {
					versions 1.1
				}
			}
		}
	}

	# Hermes: semua sub-resource yang berasal dari dashboard Hermes (absolut path)
	# diarahkan ke hermes-dashboard. Tanpa split ini static assets jatuh ke
	# catch-all aplikasi lain (misal Kuma) dan dikembalikan sebagai text/html.
	@hermes {
		header_regexp Referer ^https?://[^/]*/hermes(/.*)?$
	}
	handle @hermes {
		forward_auth 127.0.0.1:9091 {
			uri /auth/api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy 127.0.0.1:9119 {
			header_up X-Forwarded-Prefix /hermes
			header_up Host 127.0.0.1:9119
			header_up Origin http://127.0.0.1:9119
			transport http {
				versions 1.1
			}
		}
	}

	# ── MT5 noVNC ──
	# route{}: forward_auth SEBELUM strip /mt5 → rd= Authelia tetap
	# /mt5/... (pola sama dengan /status, insiden 2026-08-08).
	@mt5_path path /mt5*
	handle @mt5_path {
		route {
			forward_auth 127.0.0.1:9091 {
				uri /auth/api/authz/forward-auth
				copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
			}
			uri strip_prefix /mt5
			reverse_proxy 127.0.0.1:6901
		}
	}


	# ── Hermes API (OpenAI-compatible, port 8642) ──
	handle /hermes-api* {
		forward_auth 127.0.0.1:9091 {
			uri /auth/api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		uri strip_prefix /hermes-api
		reverse_proxy 127.0.0.1:8642 {
			transport http {
				versions 1.1
			}
		}
	}


	# ── Caddy logs via Dozzle (read-only Docker log viewer) ──
	handle /logs* {
		forward_auth 127.0.0.1:9091 {
			uri /auth/api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy 127.0.0.1:8083
	}

	# ── noVNC websockify: client konek ke path ABSOLUT /websockify
	# (bukan /mt5/websockify) — tanpa route ini jatuh ke catch-all → failed ──
	handle /websockify* {
		forward_auth 127.0.0.1:9091 {
			uri /auth/api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy 127.0.0.1:6901
	}

	# ── Uptime Kuma UI ──
	# Kuma Vue SPA hardcodes /dashboard sbg base path (tidak bisa
	# dikonfigurasi via env var). /health dan /monitoring redirect
	# ke /dashboard. Hedge fund dashboard utama akan pakai /terminal
	# (atau path lain, diputuskan saat Phase 15 frontend).

	# /health → redirect ke Kuma dashboard
	handle /health* {
		forward_auth 127.0.0.1:9091 {
			uri /auth/api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		redir * /dashboard 302
	}

	# /monitoring → redirect ke Kuma dashboard
	handle /monitoring* {
		forward_auth 127.0.0.1:9091 {
			uri /auth/api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		redir * /dashboard 302
	}

	# /dashboard → Kuma UI (path hardcoded oleh Vue SPA Kuma)
	handle /dashboard* {
		forward_auth 127.0.0.1:9091 {
			uri /auth/api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy 127.0.0.1:3001
	}

	# ── Uptime Kuma: absolute paths (assets TANPA strip, socket.io, icons) ──
	handle /assets* {
		forward_auth 127.0.0.1:9091 {
			uri /auth/api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy 127.0.0.1:3001
	}

	handle /socket.io* {
		forward_auth 127.0.0.1:9091 {
			uri /auth/api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy 127.0.0.1:3001
	}

	handle /icon.svg {
		forward_auth 127.0.0.1:9091 {
			uri /auth/api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy 127.0.0.1:3001
	}

	handle /manifest.json {
		forward_auth 127.0.0.1:9091 {
			uri /auth/api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy 127.0.0.1:3001
	}

	handle /service-worker.js {
		forward_auth 127.0.0.1:9091 {
			uri /auth/api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy 127.0.0.1:3001
	}

	handle /upload/* {
		forward_auth 127.0.0.1:9091 {
			uri /auth/api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy 127.0.0.1:3001
	}

	# ── Uptime Kuma: API endpoints (status-page, badge, push, entry-page dll) ──
	handle /api/badge* {
		forward_auth 127.0.0.1:9091 {
			uri /auth/api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy 127.0.0.1:3001
	}

	handle /api/entry-page* {
		forward_auth 127.0.0.1:9091 {
			uri /auth/api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy 127.0.0.1:3001
	}

	handle /api/push* {
		forward_auth 127.0.0.1:9091 {
			uri /auth/api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy 127.0.0.1:3001
	}

	handle /api/status-page* {
		forward_auth 127.0.0.1:9091 {
			uri /auth/api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy 127.0.0.1:3001
	}

	# ── Lumine backend (FastAPI root: /health, /docs) ──
	@backend_path path /backend*
	handle @backend_path {
		route {
			forward_auth 127.0.0.1:9091 {
				uri /auth/api/authz/forward-auth
				copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
			}
			uri strip_prefix /backend
			reverse_proxy 127.0.0.1:8000
		}
	}

	handle {
		respond "Not Found" 404
	}
}

# ── 9router LLM gateway (Next.js standalone, container bind 172.18.0.4:20128) ──
# DUA jalur:
#  - /v1/* (API OpenAI-compatible): LANGSUNG ke 9router, NO Authelia.
#    9router punya auth sendiri (API key; server key di dashboard).
#    Tanpa key → 401. Agent (OpenClaude, curl, script) pakai route ini.
#  - / (dashboard UI): tetap di balik Authelia (login admin).
https://166-88-227-177.sslip.io:8443 {
	tls internal

	# API: bypass Authelia — 9router menangani auth sendiri (Bearer key).
	@api path /v1/*
	handle @api {
		reverse_proxy 172.18.0.4:20128
	}

	# Dashboard & semua path lain: wajib login Authelia.
	handle {
		forward_auth 127.0.0.1:9091 {
			uri /auth/api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy 172.18.0.4:20128
	}
}
