# Caddyfile Configuration for Lumine Control Plane
# Reverse proxy with TLS auto-HTTPS (Let's Encrypt)
# Deploy: docker compose -f infrastructure/control-plane/docker-compose.yml up -d

166.88.227.177 {
    # Root redirect
    @root {
        path /
        path /index.html
    }
    
    respond @root "Lumine Hedge Fund Platform - Production Environment" 200
    
    # Landing page
    reverse_proxy http://localhost:8080
    
    # Authelia authentication
    @protected {
        path /homepage/* /uptime-kuma/* /dozzle/*
    }
    
    # Redirect protected routes to Authelia login
    reverse_proxy @protected authelia:9091
    
    # Health check endpoint
    @health {
        path /health
    }
    respond @health "ok" 200
    
    # Rate limiting (prevent abuse)
    rate_limit {
        per_second 100
        burst 150
        match_strategy header :authority
    }
    
    # Headers security
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
