# Control-plane secrets — copy to .env and fill with real values.
# Do NOT commit .env. Generate fresh secrets per deployment.

# Authelia identity_validation.reset_password.jwt_secret
# 64-char hex. Generate: openssl rand -hex 32
AUTHELIA_JWT_SECRET=

# Authelia session.secret (signs browser cookies)
# 64-char hex. Generate: openssl rand -hex 32
AUTHELIA_SESSION_SECRET=

# Authelia storage.encryption_key (encrypts TOTP/2FA state at rest in SQLite)
# MUST be exactly 64 chars. Generate: openssl rand -hex 32
AUTHELIA_STORAGE_ENCRYPTION_KEY=
