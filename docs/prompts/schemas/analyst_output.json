{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lumine.local/schemas/analyst_output.json",
  "title": "AnalystOutput",
  "description": "Structured output emitted by each of the four analyst sub-roles (technical, macro, news, smc). One row per analyst per decision cycle.",
  "type": "object",
  "required": [
    "sub_role",
    "argument",
    "confidence",
    "bias",
    "volatility",
    "plan"
  ],
  "additionalProperties": false,
  "properties": {
    "sub_role": {
      "type": "string",
      "enum": [
        "technical_analyst",
        "macro_analyst",
        "news_analyst",
        "smc_analyst"
      ]
    },
    "argument": {
      "type": "string",
      "description": "Concise evidence-based reasoning for the bias.",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Analyst confidence in its own bias."
    },
    "bias": {
      "type": "string",
      "enum": [
        "bullish",
        "bearish",
        "neutral"
      ],
      "description": "Directional bias"
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional references to inputs (feature names, headlines, levels)."
    },
    "volatility": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "extreme"
          ]
        },
        "expected_pre_event": {
          "type": "string",
          "description": "Vol expectation before high-impact news"
        },
        "expected_post_event": {
          "type": "string",
          "description": "Vol expectation after high-impact news"
        },
        "atr_note": {
          "type": "string",
          "description": "ATR context if available"
        }
      }
    },
    "plan": {
      "type": "object",
      "properties": {
        "pre_news": {
          "type": "string",
          "description": "Positioning plan BEFORE high-impact events"
        },
        "post_news": {
          "type": "string",
          "description": "Reaction plan AFTER high-impact events"
        },
        "high_impact_within_24h": {
          "type": "boolean"
        }
      }
    }
  }
}