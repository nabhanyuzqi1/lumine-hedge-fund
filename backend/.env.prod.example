# Lumine VPS environment — copy ke .env dan isi nilai produksi.
# JANGAN commit .env (sudah di .gitignore).

# ── Database ─────────────────────────────────────────────────────────────
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── API auth (HMAC) ───────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
HMAC_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32

# ── LLM gateway (9router) — provider mengisi API key setelah deploy ─────────
# Base URL menunjuk service 9router in-container (port 20128, publik untuk
# agent eksternal). API key KOSONG = gateway live tapi belum terautentikasi;
# isi LLM_GATEWAY_API_KEY dengan key dari provider 9router.
LLM_GATEWAY_URL=http://9router:20128
LLM_GATEWAY_API_KEY=

# ── Session auth (internal, replaces Authelia/Keycloak) ──────────────────
# Bootstrap users (superadmin/admin/trader) di-seed idempotent ke tabel
# `users` saat API start. Ganti password produksi di sini; hash PBKDF2
# dibuat otomatis (hash + salt per user, tidak pernah plaintext).
# HMAC_SECRET_KEY (di atas) dipakai sebagai signing key session cookie.
SESSION_TTL_SECONDS=43200
SUPERADMIN_PASSWORD=CHANGE_ME_superadmin_password
ADMIN_PASSWORD=CHANGE_ME_admin_password
TRADER_PASSWORD=CHANGE_ME_trader_password

# ── Caddy basicauth untuk superadmin (sementara sebelum domain+HTTPS) ───────
# Generate hash: docker run --rm caddy:latest caddy hash-password --plaintext "yourpassword"
CADDY_ADMIN_USER=superadmin
CADDY_ADMIN_HASH=CHANGE_ME_caddy_hash_password_output

# ── Frontend build args ───────────────────────────────────────────────────
# VITE_API_URL harus reachable dari BROWSER (entry publik).
VITE_API_URL=http://166.88.227.177
# Key + secret API yang DITERBITKAN backend (POST /api/v1/admin/keys).
# Urutan: deploy api dulu → issue key → isi di sini → up frontend.
VITE_LUMINE_API_KEY=
VITE_LUMINE_API_SECRET=
