http://lumine.biz.id, http://www.lumine.biz.id, http://166.88.227.177 {

    handle /api/* {
        reverse_proxy api:8000
    }
    handle /health {
        reverse_proxy api:8000
    }
    handle /metrics {
        reverse_proxy api:8000
    }

    # Authelia portal + assets
    # strip_prefix /auth agar Authelia terima /static/... bukan /auth/static/...
    # server.address di Authelia config: tcp://0.0.0.0:9091/auth
    # sehingga <base href="/auth/"> di-generate dan assets resolve dengan benar
    handle /auth/* {
        uri strip_prefix /auth
        reverse_proxy authelia:9091
    }

    @superadmin {
        path /superadmin*
    }
    handle @superadmin {
        forward_auth authelia:9091 {
            uri /api/verify?rd=https://lumine.biz.id/superadmin
            copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
        }
        reverse_proxy frontend:80
    }

    @novnc {
        path /novnc*
    }
    handle @novnc {
        forward_auth authelia:9091 {
            uri /api/verify?rd=https://lumine.biz.id/novnc/
            copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
        }
        uri strip_prefix /novnc
        reverse_proxy lumine-mt5:6901
    }

    @dozzle {
        path /dozzle*
    }
    handle @dozzle {
        forward_auth authelia:9091 {
            uri /api/verify?rd=https://lumine.biz.id/dozzle/
            copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
        }
        uri strip_prefix /dozzle
        reverse_proxy dozzle:8080
    }

    @ninerouter {
        path /9router*
    }
    handle @ninerouter {
        forward_auth authelia:9091 {
            uri /api/verify?rd=https://lumine.biz.id/9router/
            copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
        }
        uri strip_prefix /9router
        reverse_proxy 9router:20128
    }

    handle {
        reverse_proxy frontend:80
    }

    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy same-origin
        -Server
    }

    handle_errors {
        @unauth {
            expression {http.error.status_code} == 401
        }
        handle @unauth {
            redir https://lumine.biz.id/auth/?rd={http.request.uri} 302
        }
    }
}
