# Lumine production Caddyfile (VPS) — Caddy basic auth untuk superadmin.
#
# Auth model saat ini: Caddy basicauth (HTTP, bare IP)
# Auth model setelah domain+HTTPS: ganti ke Authelia forward-auth
#
# Routes:
#   /api/*          → backend api (publik, auth via HMAC)
#   /health         → api (probe)
#   /superadmin*    → frontend SPA + Caddy basicauth
#   /novnc*         → MT5 noVNC + Caddy basicauth
#   /dozzle*        → dozzle log viewer + Caddy basicauth
#   /9router*       → 9router dashboard + Caddy basicauth
#   lainnya         → frontend SPA (publik)
#
# Password hash: generate dengan `caddy hash-password --plaintext "your-password"`
# atau: docker run --rm caddy:latest caddy hash-password --plaintext "your-password"
#
# TODO setelah lumine.biz.id + Cloudflare aktif:
#   1. Ganti host ke https://lumine.biz.id
#   2. Tambah Authelia service ke compose + forward_auth directive
#   3. Hapus basicauth blocks

http://lumine.biz.id, http://www.lumine.biz.id, http://166.88.227.177 {

    # ── API (HMAC auth, tidak perlu basicauth) ────────────────────────────────
    handle /api/* {
        reverse_proxy api:8000
    }

    handle /health {
        reverse_proxy api:8000
    }

    handle /metrics {
        reverse_proxy api:8000
    }

    # ── MT5 noVNC — Caddy basicauth ───────────────────────────────────────────
    @novnc {
        path /novnc*
    }
    handle @novnc {
        basicauth {
            {$CADDY_ADMIN_USER} {$CADDY_ADMIN_HASH}
        }
        uri strip_prefix /novnc
        reverse_proxy lumine-mt5:6901
    }

    # ── Dozzle log viewer — Caddy basicauth ───────────────────────────────────
    @dozzle {
        path /dozzle*
    }
    handle @dozzle {
        basicauth {
            {$CADDY_ADMIN_USER} {$CADDY_ADMIN_HASH}
        }
        uri strip_prefix /dozzle
        reverse_proxy dozzle:8080
    }

    # ── 9router dashboard — Caddy basicauth ───────────────────────────────────
    @ninerouter {
        path /9router*
    }
    handle @ninerouter {
        basicauth {
            {$CADDY_ADMIN_USER} {$CADDY_ADMIN_HASH}
        }
        uri strip_prefix /9router
        reverse_proxy 9router:20128
    }

    # ── Superadmin SPA — Caddy basicauth ─────────────────────────────────────
    @superadmin {
        path /superadmin*
    }
    handle @superadmin {
        basicauth {
            {$CADDY_ADMIN_USER} {$CADDY_ADMIN_HASH}
        }
        reverse_proxy frontend:80
    }

    # ── Frontend SPA (publik) ─────────────────────────────────────────────────
    handle {
        reverse_proxy frontend:80
    }

    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy same-origin
        -Server
    }
}
