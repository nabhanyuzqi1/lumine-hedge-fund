http://lumine.biz.id, http://www.lumine.biz.id, http://166.88.227.177 {

    handle /api/* {
        reverse_proxy api:8000
    }
    handle /health {
        reverse_proxy api:8000
    }
    handle /metrics {
        reverse_proxy api:8000
    }

    @keycloak {
        path /auth*
    }
    handle @keycloak {
        reverse_proxy keycloak:8080
    }

    @superadmin {
        path /superadmin*
    }
    handle @superadmin {
        reverse_proxy frontend:80
    }

    @novnc {
        path /novnc*
    }
    handle @novnc {
        uri strip_prefix /novnc
        reverse_proxy lumine-mt5:6901
    }

    @dozzle {
        path /dozzle*
    }
    handle @dozzle {
        uri strip_prefix /dozzle
        reverse_proxy dozzle:8080
    }

    handle {
        reverse_proxy frontend:80
    }

    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy same-origin
        -Server
    }
}

http://router.lumine.biz.id {
    reverse_proxy 9router:20128
}
