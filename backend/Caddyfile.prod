# Lumine production Caddyfile (VPS) — dengan Authelia SSO untuk superadmin.
#
# DOMAIN: lumine.biz.id (via Cloudflare proxy, SSL Full mode)
# VPS IP: 166.88.227.177 (tersembunyi di balik Cloudflare)
#
# Routes:
#   /api/*          → backend api (publik, auth via HMAC)
#   /health         → api (probe)
#   /superadmin*    → frontend (SPA) + Authelia forward-auth guard
#   /novnc*         → MT5 noVNC embed (Authelia protected)
#   /dozzle*        → dozzle log viewer (Authelia protected)
#   /9router*       → 9router LLM gateway dashboard (Authelia protected)
#   /auth*          → Authelia portal (login page)
#   lainnya         → frontend (SPA, publik)
#
# Catatan Cloudflare:
#   - SSL mode harus "Full" (bukan Flexible) di Cloudflare dashboard
#   - Caddy melayani HTTP di dalam VPS; Cloudflare yang terminasi TLS ke user
#   - Jika ingin Caddy auto-TLS end-to-end, ganti ke "Full (Strict)" dan
#     tambah Cloudflare Origin Certificate di VPS

# ── HTTP: selama Cloudflare masih proxy, semua traffic masuk via HTTP ke VPS
# ── Ganti ke https://lumine.biz.id setelah domain aktif dan SSL Full terkonfirmasi

http://lumine.biz.id, http://www.lumine.biz.id, http://166.88.227.177 {
    # ── Authelia portal ───────────────────────────────────────────────────────
    @authelia_auth {
        path /auth*
    }
    handle @authelia_auth {
        reverse_proxy authelia:9091
    }

    # ── API (HMAC auth, tidak perlu Authelia) ─────────────────────────────────
    handle /api/* {
        reverse_proxy api:8000
    }

    handle /health {
        reverse_proxy api:8000
    }

    handle /metrics {
        reverse_proxy api:8000
    }

    # ── MT5 noVNC — protected by Authelia ────────────────────────────────────
    @novnc {
        path /novnc*
    }
    handle @novnc {
        forward_auth authelia:9091 {
            uri /api/verify?rd=http://lumine.biz.id/novnc/
            copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
        }
        uri strip_prefix /novnc
        reverse_proxy lumine-mt5:6901
    }

    # ── Dozzle log viewer — protected by Authelia ────────────────────────────
    @dozzle {
        path /dozzle*
    }
    handle @dozzle {
        forward_auth authelia:9091 {
            uri /api/verify?rd=http://lumine.biz.id/dozzle/
            copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
        }
        uri strip_prefix /dozzle
        reverse_proxy dozzle:8080
    }

    # ── 9router dashboard — protected by Authelia ────────────────────────────
    @ninerouter {
        path /9router*
    }
    handle @ninerouter {
        forward_auth authelia:9091 {
            uri /api/verify?rd=http://lumine.biz.id/9router/
            copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
        }
        uri strip_prefix /9router
        reverse_proxy 9router:20128
    }

    # ── Superadmin SPA routes — protected by Authelia ────────────────────────
    @superadmin {
        path /superadmin*
    }
    handle @superadmin {
        forward_auth authelia:9091 {
            uri /api/verify?rd=http://lumine.biz.id/superadmin
            copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
        }
        reverse_proxy frontend:80
    }

    # ── Frontend SPA (publik) ─────────────────────────────────────────────────
    handle {
        reverse_proxy frontend:80
    }

    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy same-origin
        -Server
    }
}
