http://lumine.biz.id, http://www.lumine.biz.id, http://166.88.227.177 {

    # Authelia portal
    @auth_path {
        path /auth*
    }
    handle @auth_path {
        reverse_proxy authelia:9091
    }

    # API — HMAC auth, no Authelia
    handle /api/* {
        reverse_proxy api:8000
    }

    handle /health {
        reverse_proxy api:8000
    }

    handle /metrics {
        reverse_proxy api:8000
    }

    # MT5 noVNC — Authelia protected
    @novnc {
        path /novnc*
    }
    handle @novnc {
        forward_auth authelia:9091 {
            uri /api/verify?rd=https://lumine.biz.id/novnc/
            copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
        }
        uri strip_prefix /novnc
        reverse_proxy lumine-mt5:6901
    }

    # Dozzle — Authelia protected
    @dozzle {
        path /dozzle*
    }
    handle @dozzle {
        forward_auth authelia:9091 {
            uri /api/verify?rd=https://lumine.biz.id/dozzle/
            copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
        }
        uri strip_prefix /dozzle
        reverse_proxy dozzle:8080
    }

    # 9router — Authelia protected
    @ninerouter {
        path /9router*
    }
    handle @ninerouter {
        forward_auth authelia:9091 {
            uri /api/verify?rd=https://lumine.biz.id/9router/
            copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
        }
        uri strip_prefix /9router
        reverse_proxy 9router:20128
    }

    # Superadmin SPA — Authelia protected
    @superadmin {
        path /superadmin*
    }
    handle @superadmin {
        forward_auth authelia:9091 {
            uri /api/verify?rd=https://lumine.biz.id/superadmin
            copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
        }
        reverse_proxy frontend:80
    }

    # Frontend SPA — public
    handle {
        reverse_proxy frontend:80
    }

    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy same-origin
        -Server
    }
}
