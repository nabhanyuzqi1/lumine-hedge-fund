# Contoh konfigurasi alert Telegram fund2 (copy ke .env.alerts, isi nilainya).
# Token bot dari @BotFather; owner id = telegram user id pemilik (satu-satunya
# yang dilayani perintah & penerima alert).
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
# Jam rekap harian WIB (default 07:00)
TELEGRAM_RECAP_HOUR_WIB=7
