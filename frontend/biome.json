{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "organizeImports": {
    "enabled": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "parser": {
      "unsafeParameterPropertyDeployment": false,
      "trailingCommas": "es5",
      "jsxSyntax": "pretty"
    },
    "formatter": {
      "semicolens": "always",
      "trailingComma": "es5",
      "quoteStyle": "double"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "css": {
    "formatter": {
      "indentWidth": 2,
      "lineWidth": 100,
      "quoteStyle": "double"
    },
    "linter": {
      "enabled": true
    }
  },
  "overrides": [
    {
      "include": ["*.ts", "*.tsx"],
      "linter": {
        "enabled": true,
        "rules": {
          "recommended": true,
          "style": {
            "noNonNullAssertion": "off"
          },
          "a11y": {
            "useButtonType": "error",
            "useKeyWithClickEvents": "error"
          },
          "complexity": {
            "noUselessFragments": "error"
          },
          "correctness": {
            "noUnusedImports": "error",
            "noUnusedVariables": "error"
          }
        }
      }
    }
  ]
}
