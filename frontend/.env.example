# Lumine Frontend Environment Variables

# Backend API URL (FastAPI)
VITE_API_URL=http://localhost:8000

# HMAC-SHA256 API credentials (docs/09-api/auth.md, backend middleware/auth.py).
# BOTH must be set for the frontend to sign requests; leave unset for dev.
# `bootstrap` key + the bootstrap secret from Settings.hmac_secret_key work
# against a local backend (backend/.env.example).
VITE_LUMINE_API_KEY=bootstrap
VITE_LUMINE_API_SECRET=your-bootstrap-secret-here

# SSE Connection settings
VITE_SSE_TIMEOUT=30000

# Reconnection configuration
VITE_RECONNECT_MAX_ATTEMPTS=5
VITE_RECONNECT_DELAY=1000
