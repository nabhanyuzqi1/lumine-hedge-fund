# ── Data ───────────────────────────────────────────────────────────────────
# Root-anchored: ignore only the top-level runtime artifact dir, NOT source
# directories named `data` (e.g. backend/src/lumine/data/). Per-backend
# artifact dirs are scoped explicitly below.
/data/
backend/.data/
*.db
*.sqlite
*.sqlite3

# ── Logs ───────────────────────────────────────────────────────────────────
*.log
logs/

# ── OS ─────────────────────────────────────────────────────────────────────
