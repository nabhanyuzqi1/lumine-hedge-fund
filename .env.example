# Lumine — Environment Configuration

# LLM Gateway (9router)
LLM_GATEWAY_BASE_URL=https://api.9router.com
LLM_GATEWAY_API_KEY=your_9router_api_key_here

# Budget Limits (USD)
LLM_DAILY_BUDGET=500.0
LLM_WEEKLY_BUDGET=2500.0

# Concurrency Limits
LLM_MAX_CONCURRENT=100

# Circuit Breaker Settings
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_RECOVERY_TIMEOUT=300

# Model Registry
LLM_REGISTRY_BACKEND=database  # or 'simple' for in-memory

# Logging Level
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/lumine

# MetaTrader 5
MT5_SERVER=YourBrokerServer
MT5_LOGIN=12345678
MT5_PASSWORD=your_password

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379/0
