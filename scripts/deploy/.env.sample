# Copy ke .env lalu isi dengan nilai nyata. JANGAN commit .env ke git!
# Untuk referensi value: lihat .env lokal atau VPS.

# ── Target VPS ───────────────────────────────────────────────────
VPS_HOST=166.88.227.177
VPS_USER=root
VPS_SSH_PORT=22

# ── Database ─────────────────────────────────────────────────────
DB_PASSWORD=lumine-admin-2026
DB_USER=lumine
DB_NAME=lumine

# ── API ──────────────────────────────────────────────────────────
HMAC_SECRET_KEY=<generate-with-openssl-rand-hex-64>
LLM_GATEWAY_API_KEY=<9router-API-key>

# ── Git ──────────────────────────────────────────────────────────
GITHUB_REPO=nabhanyuzqi1/lumine-hedge-fund

# ── Backup / Restore ─────────────────────────────────────────────
BACKUP_DIR=/root/lumine-backups
BACKUP_RETENTION_DAYS=7
GITHUB_BACKUP_REPO=nabhanyuzqi1/lumine-backups  # repository khusus untuk backup
GITHUB_BACKUP_TOKEN=<github-token-with-repo-scope>

# ── Komponen opsional (true/false) ───────────────────────────────
INSTALL_9ROUTER=true
INSTALL_HERMES=true
INSTALL_OPENCLAUDE=true
INSTALL_LUMINE=true
INSTALL_DOCKER=true

# ── Authelia Configuration ────────────────────────────────────────
# User: admin | Password: lumine-admin-2026!
AUTHEDIA_REMEMBER_DOMAIN=166.88.227.177
AUTHEDIA_REMEMBER_FOR=5m
AUTHERIA_SESSION_SECRET=<generate-with-openssl-rand-hex-64>
AUTHERIA_STORAGE_ENCRYPTION_KEY=<generate-with-openssl-rand-32-base64>

# ── MT5 / VNC (Wine in Docker, lihat VPS-GUIDE.md Bagian 0) ──────────────────
# Password untuk akses noVNC (browser) + VNC client. MINIMAL 6 char.
# Ganti ke password kuat unik sebelum produksi.
VNC_PASSWORD=lumine-mt5-vnc-2026
